<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product List View -->
    <record id="mutego_product_list_view" model="ir.ui.view">
        <field name="name">mutego.product.tree</field>
        <field name="model">mutego.product</field>
        <field name="arch" type="xml">
            <tree string="Products" decoration-muted="not is_active">
                <field name="sequence" widget="handle"/>
                <field name="image_thumb" widget="image" options="{'size': [50, 50]}"/>
                <field name="name"/>
                <field name="brand"/>
                <field name="category"/>
                <field name="volume_ml"/>
                <field name="is_featured"/>
                <field name="website_published"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <!-- Product Form View -->
    <record id="mutego_product_form_view" model="ir.ui.view">
        <field name="name">mutego.product.form</field>
        <field name="model">mutego.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="is_active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Product Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Product Details">
                            <field name="brand"/>
                            <field name="category"/>
                            <field name="volume_ml"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Website Settings">
                            <field name="website_published"/>
                            <field name="is_featured"/>
                            <field name="slug"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Product Kanban View -->
    <record id="mutego_product_kanban_view" model="ir.ui.view">
        <field name="name">mutego.product.kanban</field>
        <field name="model">mutego.product</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="brand"/>
                <field name="image_thumb"/>
                <field name="is_active"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('mutego.product', 'image_thumb', record.id.raw_value)"
                                     alt="Product" class="o_image_64_max"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="o_kanban_tags_section">
                                    <field name="brand"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Product Search View -->
    <record id="mutego_product_search_view" model="ir.ui.view">
        <field name="name">mutego.product.search</field>
        <field name="model">mutego.product</field>
        <field name="arch" type="xml">
            <search string="Search Products">
                <field name="name"/>
                <field name="brand"/>
                <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Published" name="published" domain="[('website_published', '=', True)]"/>
                <filter string="Featured" name="featured" domain="[('is_featured', '=', True)]"/>
                <separator/>
                <filter string="Pepsi" name="pepsi" domain="[('brand', '=', 'pepsi')]"/>
                <filter string="7UP" name="7up" domain="[('brand', '=', '7up')]"/>
                <filter string="Mountain Dew" name="mountain_dew" domain="[('brand', '=', 'mountain_dew')]"/>
                <filter string="Mirinda" name="mirinda" domain="[('brand', '=', 'mirinda')]"/>
                <filter string="Aquafina" name="aquafina" domain="[('brand', '=', 'aquafina')]"/>
                <filter string="Lipton" name="lipton" domain="[('brand', '=', 'lipton')]"/>
                <group expand="0" string="Group By">
                    <filter string="Brand" name="group_brand" context="{'group_by': 'brand'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Product Action -->
    <record id="action_mutego_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">mutego.product</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
