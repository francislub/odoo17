<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         CONTACT US PAGE
         ===================================================================== -->
    <template id="contact_page" name="Contact Us">
        <t t-call="mutego_distribution.mutego_layout">

            <section class="mutego-page-hero">
                <div class="container text-center">
                    <h1 class="page-hero-title">Get in Touch</h1>
                    <p class="page-hero-subtitle">
                        We would love to hear from you. Reach out to us through any of our branches.
                    </p>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb justify-content-center">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active">Contact Us</li>
                        </ol>
                    </nav>
                </div>
            </section>

            <section class="mutego-section">
                <div class="container">

                    <!-- Success Message -->
                    <t t-if="success">
                        <div class="alert mutego-alert-success mb-5" role="alert">
                            <i class="fa fa-check-circle me-2"/>
                            <strong>Message Sent!</strong> Thank you for contacting us.
                            Our team will get back to you within 1-2 business days.
                        </div>
                    </t>

                    <!-- Error Message -->
                    <t t-if="error">
                        <div class="alert alert-danger mb-4" role="alert">
                            <i class="fa fa-exclamation-circle me-2"/>
                            <t t-esc="error"/>
                        </div>
                    </t>

                    <div class="row gy-5">

                        <!-- Contact Form -->
                        <div class="col-lg-7">
                            <div class="contact-form-card">
                                <h3 class="mb-4">Send Us a Message</h3>
                                <form action="/contact/submit" method="post" class="mutego-form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="row gy-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="contact_name">Full Name <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control mutego-input" id="contact_name"
                                                   name="name" required="required"
                                                   t-att-value="form_data.get('name', '') if form_data else ''"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="contact_email">Email Address <span class="text-danger">*</span></label>
                                            <input type="email" class="form-control mutego-input" id="contact_email"
                                                   name="email" required="required"
                                                   t-att-value="form_data.get('email', '') if form_data else ''"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="contact_phone">Phone Number</label>
                                            <input type="tel" class="form-control mutego-input" id="contact_phone"
                                                   name="phone"
                                                   t-att-value="form_data.get('phone', '') if form_data else ''"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="contact_branch">Nearest Branch</label>
                                            <select class="form-select mutego-input" id="contact_branch" name="branch_id">
                                                <option value="">Select a branch...</option>
                                                <t t-foreach="branches" t-as="branch">
                                                    <option t-att-value="branch.id" t-esc="branch.name"/>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label" for="contact_subject">Subject</label>
                                            <input type="text" class="form-control mutego-input" id="contact_subject"
                                                   name="subject"
                                                   t-att-value="form_data.get('subject', '') if form_data else ''"/>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label" for="contact_message">Message <span class="text-danger">*</span></label>
                                            <textarea class="form-control mutego-input" id="contact_message"
                                                      name="message" rows="6" required="required">
                                                <t t-esc="form_data.get('message', '') if form_data else ''"/>
                                            </textarea>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn mutego-btn-primary btn-lg w-100">
                                                <i class="fa fa-paper-plane me-2"/>
                                                Send Message
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Contact Info Sidebar -->
                        <div class="col-lg-5">
                            <div class="contact-info-block mb-4">
                                <h3 class="mb-4">Contact Information</h3>
                                <div class="contact-info-item">
                                    <div class="contact-info-icon"><i class="fa fa-map-marker"/></div>
                                    <div>
                                        <strong>Headquarters</strong>
                                        <p>123 Industrial Area, Likoni Road<br/>Nairobi, Kenya</p>
                                    </div>
                                </div>
                                <div class="contact-info-item">
                                    <div class="contact-info-icon"><i class="fa fa-phone"/></div>
                                    <div>
                                        <strong>Phone</strong>
                                        <p><a href="tel:+254700100000">+254 700 100 000</a></p>
                                    </div>
                                </div>
                                <div class="contact-info-item">
                                    <div class="contact-info-icon"><i class="fa fa-envelope"/></div>
                                    <div>
                                        <strong>Email</strong>
                                        <p><a href="mailto:info@mutego.co.ke">info@mutego.co.ke</a></p>
                                    </div>
                                </div>
                                <div class="contact-info-item">
                                    <div class="contact-info-icon"><i class="fa fa-clock-o"/></div>
                                    <div>
                                        <strong>Working Hours</strong>
                                        <p>Monday to Friday: 8:00 AM – 5:00 PM<br/>Saturday: 8:00 AM – 1:00 PM</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Branch Quick Links -->
                            <div class="contact-branches-block">
                                <h5 class="mb-3">All Branches</h5>
                                <t t-foreach="branches" t-as="branch">
                                    <div class="contact-branch-row">
                                        <div>
                                            <strong t-esc="branch.name"/>
                                            <t t-if="branch.is_headquarters">
                                                <span class="ms-1 badge-hq">HQ</span>
                                            </t>
                                            <br/>
                                            <small t-esc="branch.city"/>
                                        </div>
                                        <t t-if="branch.phone">
                                            <a t-att-href="'tel:' + branch.phone" class="branch-phone-link" t-esc="branch.phone"/>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

        </t>
    </template>

</odoo>
