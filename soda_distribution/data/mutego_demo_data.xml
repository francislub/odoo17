        <!-- ── NEWS ──────────────────────────────────────────────────────── -->

        <record id="news_eldoret_expansion" model="mutego.news">
            <field name="title">Mutego Distribution Expands to Eldoret</field>
            <field name="summary">Mutego Distribution Company is proud to announce the opening of our newest branch in Eldoret, bringing our premium Pepsi and 7UP products closer to customers in the Rift Valley region.</field>
            <field name="content">&lt;p&gt;Mutego Distribution Company continues its expansion across Kenya with the official launch of our Eldoret branch. Located on Uganda Road, the new facility will serve retailers and wholesalers across the Rift Valley. The branch is managed by David Kipchoge and features a full cold-chain storage facility.&lt;/p&gt;&lt;p&gt;We are committed to ensuring that every bottle of Pepsi, 7UP, Mountain Dew, and Mirinda reaches our customers at peak freshness. The Eldoret branch represents our confidence in the growth potential of the North Rift region.&lt;/p&gt;</field>
            <field name="author">Mutego Distribution</field>
            <field name="published_date" eval="(DateTime.now() - relativedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="is_featured">True</field>
            <field name="website_published">True</field>
        </record>

        <record id="news_7up_free" model="mutego.news">
            <field name="title">New 7UP Free — Zero Sugar, Full Flavor</field>
            <field name="summary">We are now distributing the all-new 7UP Free across all our branches. Enjoy the crisp lemon-lime taste you love with zero sugar.</field>
            <field name="content">&lt;p&gt;7UP Free is now available through all Mutego Distribution branches nationwide. The new zero-sugar variant delivers the same refreshing citrus taste as the original 7UP — perfect for health-conscious consumers who refuse to compromise on flavor.&lt;/p&gt;&lt;p&gt;Available in 330ml cans and 500ml bottles. Contact your nearest Mutego branch to add 7UP Free to your order today.&lt;/p&gt;</field>
            <field name="author">Mutego Distribution</field>
            <field name="published_date" eval="(DateTime.now() - relativedelta(days=14)).strftime('%Y-%m-%d')"/>
            <field name="is_featured">False</field>
            <field name="website_published">True</field>
        </record>

        <record id="news_award_2024" model="mutego.news">
            <field name="title">Mutego Wins Best Distributor Award 2024</field>
            <field name="summary">We are honored to have been recognized as the Best PepsiCo Distributor in East Africa for 2024 at the annual Beverages Excellence Awards.</field>
            <field name="content">&lt;p&gt;Mutego Distribution received the prestigious Best Distributor Award at the 2024 Beverages Excellence Awards held in Nairobi. The award recognizes our exceptional distribution network, consistent delivery performance, and outstanding customer service.&lt;/p&gt;&lt;p&gt;Our team of over 200 dedicated employees across 5 branches made this achievement possible. We remain committed to raising the bar every year.&lt;/p&gt;</field>
            <field name="author">Mutego Distribution</field>
            <field name="published_date" eval="(DateTime.now() - relativedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="is_featured">False</field>
            <field name="website_published">True</field>
